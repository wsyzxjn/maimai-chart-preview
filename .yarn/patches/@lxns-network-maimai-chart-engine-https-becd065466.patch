index 0000000000000000000000000000000000000000..ae9312f872d3cfa754ecd50114d98ac21af9c3ff
--- /dev/null
+++ b/src/core/parser/SimaiSections.ts
@@ -0,0 +1,101 @@
+export interface SimaiSourceLine {
+  line: number;
+  column: number;
+  text: string;
+}
+
+export interface SimaiSection {
+  id: number;
+  line: number;
+  body: SimaiSourceLine[];
+}
+
+/**
+ * 提取数字编号段落及原始行号，允许空正文；不会解析 Note。
+ * 非法或重复声明在 error 中返回，调用方不得将其当作无分段谱面回退。
+ */
+export function readSimaiSections(text: string): {
+  sections: SimaiSection[];
+  metadata: SimaiSourceLine[];
+  body: SimaiSourceLine[];
+  hasSectionDeclarations: boolean;
+  error?: string;
+  errorLine?: number;
+  errorColumn?: number;
+} {
+  const sections: SimaiSection[] = [];
+  const metadata: SimaiSourceLine[] = [];
+  const body: SimaiSourceLine[] = [];
+  const ids = new Set<number>();
+  let current: SimaiSection | undefined;
+  let hasSectionDeclarations = false;
+  let error: string | undefined;
+  let errorLine: number | undefined;
+  let errorColumn: number | undefined;
+  let blockStart: { line: number; column: number } | undefined;
+
+  for (const [line, raw] of text
+    .replace(/^\uFEFF/, " ")
+    .split(/\r?\n/)
+    .entries()) {
+    let cleaned = raw;
+    if (blockStart || !raw.trimStart().startsWith("&") || /^\s*&inote/i.test(raw)) {
+      const chars = raw.split("");
+      for (let column = 0; column < raw.length; column++) {
+        if (blockStart) {
+          chars[column] = " ";
+          if (raw.slice(column, column + 2) === "*/") {
+            chars[++column] = " ";
+            blockStart = undefined;
+          }
+        } else if (raw.slice(column, column + 2) === "//") {
+          chars.fill(" ", column);
+          break;
+        } else if (raw.slice(column, column + 2) === "/*") {
+          blockStart = { line, column };
+          chars[column] = " ";
+          chars[++column] = " ";
+        }
+      }
+      cleaned = chars.join("");
+    }
+    const trimmed = cleaned.trim();
+    if (/^&inote/i.test(trimmed)) {
+      hasSectionDeclarations = true;
+      current = undefined;
+      const match = trimmed.match(/^&inote_([1-9]\d*)\s*=(.*)$/i);
+      const id = match ? Number(match[1]) : Number.NaN;
+      if (!match || !Number.isSafeInteger(id)) {
+        if (!error) {
+          errorLine = line;
+          errorColumn = Math.max(0, cleaned.indexOf("&"));
+        }
+        error ??= `第 ${line + 1} 行的谱面段落声明无效：${trimmed}（需要 &inote_正整数=）`;
+        continue;
+      }
+      if (ids.has(id)) {
+        if (!error) {
+          errorLine = line;
+          errorColumn = Math.max(0, cleaned.indexOf("&"));
+        }
+        error ??= `第 ${line + 1} 行重复声明谱面 ${id}`;
+        continue;
+      }
+      ids.add(id);
+      const column = cleaned.indexOf("=") + 1;
+      current = { id, line, body: [{ line, column, text: cleaned.slice(column) }] };
+      sections.push(current);
+    } else if (trimmed.startsWith("&")) {
+      current = undefined;
+      metadata.push({ line, column: Math.max(0, cleaned.indexOf("&")), text: trimmed });
+    } else {
+      (current?.body ?? body).push({ line, column: 0, text: cleaned });
+    }
+  }
+  if (blockStart && !error) {
+    errorLine = blockStart.line;
+    errorColumn = blockStart.column;
+    error = `第 ${errorLine + 1} 行的块注释未闭合`;
+  }
+  return { sections, metadata, body, hasSectionDeclarations, error, errorLine, errorColumn };
+}
