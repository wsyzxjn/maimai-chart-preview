diff --git a/src/core/parser/SimaiSections.ts b/src/core/parser/SimaiSections.ts
new file mode 100644
index 0000000000000000000000000000000000000000..eddbb01e6a5af62f274dd7f2bc9bdf8c7e4ada63
--- /dev/null
+++ b/src/core/parser/SimaiSections.ts
@@ -0,0 +1,60 @@
+export interface SimaiSourceLine {
+  line: number;
+  text: string;
+}
+
+export interface SimaiSection {
+  id: number;
+  line: number;
+  body: SimaiSourceLine[];
+}
+
+/**
+ * 提取数字编号段落及原始行号，允许空正文；不会解析 Note。
+ * 非法或重复声明在 error 中返回，调用方不得将其当作无分段谱面回退。
+ */
+export function readSimaiSections(text: string): {
+  sections: SimaiSection[];
+  metadata: string[];
+  body: SimaiSourceLine[];
+  hasSectionDeclarations: boolean;
+  error?: string;
+} {
+  const sections: SimaiSection[] = [];
+  const metadata: string[] = [];
+  const body: SimaiSourceLine[] = [];
+  const ids = new Set<number>();
+  let current: SimaiSection | undefined;
+  let hasSectionDeclarations = false;
+  let error: string | undefined;
+
+  for (const [line, raw] of text
+    .replace(/^\uFEFF/, "")
+    .split(/\r?\n/)
+    .entries()) {
+    const trimmed = raw.trim();
+    if (/^&inote/i.test(trimmed)) {
+      hasSectionDeclarations = true;
+      current = undefined;
+      const match = trimmed.match(/^&inote_([1-9]\d*)\s*=(.*)$/i);
+      const id = match ? Number(match[1]) : Number.NaN;
+      if (!match || !Number.isSafeInteger(id)) {
+        error ??= `第 ${line + 1} 行的谱面段落声明无效：${trimmed}（需要 &inote_正整数=）`;
+        continue;
+      }
+      if (ids.has(id)) {
+        error ??= `第 ${line + 1} 行重复声明谱面 ${id}`;
+        continue;
+      }
+      ids.add(id);
+      current = { id, line, body: [{ line, text: match[2] }] };
+      sections.push(current);
+    } else if (trimmed.startsWith("&")) {
+      current = undefined;
+      metadata.push(trimmed);
+    } else {
+      (current?.body ?? body).push({ line, text: raw });
+    }
+  }
+  return { sections, metadata, body, hasSectionDeclarations, error };
+}
