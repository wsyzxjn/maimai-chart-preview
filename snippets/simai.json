{
  "Simai Header": {
    "prefix": "simai-header",
    "body": [
      "&title=${1:Title}",
      "&artist=${2:Artist}",
      "&des=${3:Designer}",
      "&first=0",
      "&bpm=${4:120}",
      "",
      "&inote_4=",
      "(${4:120}){4}",
      "$0",
      "E"
    ],
    "description": "Template header for a Simai EXPERT chart (&inote_4)"
  },
  "BPM Change": {
    "prefix": "bpm",
    "body": "(${1:120})",
    "description": "BPM Change event"
  },
  "Divisor / Sub-beat": {
    "prefix": "div",
    "body": "{${1:4}}",
    "description": "Beat divisor change {4}, {8}, {16}, etc."
  }
}
